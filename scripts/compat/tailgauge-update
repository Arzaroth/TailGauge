#!/bin/bash
# Shipped as the `helpers` asset an install from 0.4.0 or earlier still asks
# for, and installed by that install's own updater under this name.
#
# There are no helpers any more: the eight shell scripts are one binary, which
# that updater has no idea how to fetch. So this stands in their place, and
# what it does is finish the job - work out the architecture, pull the right
# archive, put the binary where the scripts were, and point their names at it.
#
# It then removes itself. Updating is `tailgauge --update` from here on.

set -uo pipefail

REPO="${TAILGAUGE_REPO:-Arzaroth/TailGauge}"
bindir="$HOME/.local/bin"
ALIASES=(ctl watch notify send receive file-select copy)

die() {
  echo "tailgauge-update: $1" >&2
  exit 1
}

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/tailgauge"
cache_file="$cache_dir/update.json"

# The tag of the newest release, from the same cache the old script kept and
# with the same six hours on it, so a polling panel is not a request per tick.
latest_tag() {
  local cached now
  if [[ -r $cache_file ]]; then
    cached=$(sed -n 's/.*"latest": *"\([^"]*\)".*/\1/p' "$cache_file" | head -1)
    now=$(sed -n 's/.*"checked": *"\([^"]*\)".*/\1/p' "$cache_file" | head -1)
    if [[ -n $cached && -n $now ]] && (($(date +%s) - now < 21600)); then
      printf 'v%s' "${cached#v}"
      return 0
    fi
  fi
  command -v curl >/dev/null 2>&1 || return 1
  local tag
  tag=$(curl -fsSL --max-time 15 "https://api.github.com/repos/$REPO/releases/latest" |
    sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1) || return 1
  [[ -n $tag ]] || return 1
  mkdir -p "$cache_dir" 2>/dev/null &&
    printf '{"latest":"%s","checked":"%s"}\n' "${tag#v}" "$(date +%s)" >"$cache_file"
  printf '%s' "$tag"
}

# The panel of a 0.4.0 install polls this with --json, and applies with
# --apply, so saying an upgrade is pending is what lets a user finish the
# migration from the panel they already have open. It is pending whether or
# not GitHub answers: the binary is missing from this machine either way.
for arg in "$@"; do
  if [[ $arg == --json ]]; then
    tag=$(latest_tag) || tag=""
    printf '{"available":true,"updatable":true,"latest":"%s","url":"https://github.com/%s/releases/latest","error":"","targets":[{"kind":"helpers","current":"0.4.0","latest":"%s","managed":"manual","outdated":true}]}\n' \
      "${tag#v}" "$REPO" "${tag#v}"
    exit 0
  fi
done

case "$(uname -m)" in
x86_64 | amd64) arch=x86_64 ;;
aarch64 | arm64) arch=aarch64 ;;
*) die "no TailGauge binary is published for $(uname -m)" ;;
esac

command -v curl >/dev/null 2>&1 || die "curl is required"

tag=$(latest_tag) || die "could not ask GitHub for the latest release"
[[ -n $tag ]] || die "could not ask GitHub for the latest release"

echo "TailGauge is a binary now. Installing tailgauge $tag ($arch)..."

work=$(mktemp -d) || die "could not make a working directory"
trap 'rm -rf "$work"' EXIT

curl -fsSL --max-time 300 -o "$work/archive.tar.gz" \
  "https://github.com/$REPO/releases/download/$tag/tailgauge-$tag-linux-$arch.tar.gz" ||
  die "could not download tailgauge-$tag-linux-$arch.tar.gz"
tar -C "$work" -xzf "$work/archive.tar.gz" || die "the archive did not extract"
[[ -f "$work/tailgauge" ]] || die "the archive carries no binary"

mkdir -p "$bindir"
install -m 755 "$work/tailgauge" "$bindir/tailgauge.new.$$" || {
  rm -f "$bindir/tailgauge.new.$$"
  die "could not install the binary into $bindir"
}

# Run it before it is the installed copy. A binary for the wrong libc, or a
# truncated download, is a file that exists and does nothing - and this script
# is the only way back, so it must still be here if that is what we have.
installed_version=$("$bindir/tailgauge.new.$$" --version 2>&1) || {
  rm -f "$bindir/tailgauge.new.$$"
  die "the downloaded binary does not run here: $installed_version"
}

# Renamed into place: this script is running from the same directory, and bash
# reads a script as it goes.
mv -f "$bindir/tailgauge.new.$$" "$bindir/tailgauge" || {
  rm -f "$bindir/tailgauge.new.$$"
  die "could not install the binary into $bindir"
}

# The old scripts answered these names. The binary answers to them too, by
# reading the name it was invoked as, so a key binding on tailgauge-ctl keeps
# working once the name points here.
for alias in "${ALIASES[@]}"; do
  ln -sfn tailgauge "$bindir/tailgauge-$alias"
done

if [[ -f "$work/systemd/tailgauge-receive.service" ]]; then
  mkdir -p "$HOME/.config/systemd/user"
  install -m 644 "$work/systemd/tailgauge-receive.service" \
    "$HOME/.config/systemd/user/tailgauge-receive.service"
  systemctl --user daemon-reload 2>/dev/null
  systemctl --user is-enabled tailgauge-receive.service >/dev/null 2>&1 &&
    systemctl --user restart tailgauge-receive.service 2>/dev/null
fi

echo "Installed $installed_version into $bindir."

# Last, and only now: until this runs there is a way back, and after it there
# is not.
rm -f "$bindir/tailgauge-update"
echo "Updating is 'tailgauge --update' from now on."
